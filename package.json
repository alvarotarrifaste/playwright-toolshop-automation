{
  "name": "playwright-toolshop-automation",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sut:provision": "tsx scripts/toolshop.ts provision",
    "sut:up": "tsx scripts/toolshop.ts up",
    "sut:ready": "tsx scripts/toolshop.ts ready",
    "sut:reset": "tsx scripts/toolshop.ts reset",
    "sut:down": "tsx scripts/toolshop.ts down",
    "test:controlled": "tsx scripts/toolshop.ts test",
    "test:ui": "npm run test:controlled -- --grep @ui",
    "test:api": "npm run test:controlled -- --grep @api",
    "test:smoke": "npm run test:controlled -- --grep @smoke",
    "test:auth": "npm run test:controlled -- --grep @auth",
    "test:catalog": "npm run test:controlled -- --grep @catalog",
    "test:cart": "npm run test:controlled -- --grep @cart",
    "test:checkout": "npm run test:controlled -- --grep @checkout"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.8"
  }
}
